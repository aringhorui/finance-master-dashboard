# ============================================================
# FinanceMaster Dashboard - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Your monthly salary/income (used for budget calculations)
VITE_SALARY=48000

# Gemini API Key for AI chatbot (get free at https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=

# Data source URL (your finance data JSON)
VITE_DATA_URL=https://raw.githubusercontent.com/aringhorui/finance-master-data/main/data/current.json

# Data staleness threshold in minutes
VITE_STALE_DATA_MINUTES=15
